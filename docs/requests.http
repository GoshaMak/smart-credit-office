# HTTP examples for VS Code REST Client or IntelliJ HTTP Client.
###
@baseUrl = http://localhost:8000/api/v1
@clientToken = paste-access-token-here
@bankToken = paste-bank-access-token-here
@refreshToken = paste-refresh-token-here

### login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "client",
  "password": "demo-client-password"
}


### refreshTokens
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}


### logout
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}


### getCurrentUser
GET {{baseUrl}}/auth/me
Authorization: Bearer {{clientToken}}


### listProducts
GET {{baseUrl}}/products?limit=20&offset=0
Authorization: Bearer {{clientToken}}


### getProduct
GET {{baseUrl}}/products/22222222-2222-4222-8222-222222222222
Authorization: Bearer {{clientToken}}


### listCompanies
GET {{baseUrl}}/companies
Authorization: Bearer {{clientToken}}


### createCompany
POST {{baseUrl}}/companies
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "legal_type": "legal_entity",
  "inn": "0000000000",
  "name": "ООО Компания",
  "registration_date": "2020-01-15",
  "okved": "47.91",
  "address": "Город А, Улица Б, д. 6, к. 7"
}


### getCompany
GET {{baseUrl}}/companies/11111111-1111-4111-8111-111111111111
Authorization: Bearer {{clientToken}}


### updateCompany
PATCH {{baseUrl}}/companies/11111111-1111-4111-8111-111111111111
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "expected_version": 1,
  "legal_type": "legal_entity",
  "name": "ООО Компания",
  "registration_date": "2020-01-15",
  "okved": "47.91",
  "address": "Город А, Улица Б, д. 6, к. 7"
}


### listApplications
GET {{baseUrl}}/applications?limit=20&offset=0&company_id=11111111-1111-4111-8111-111111111111&status=Draft
Authorization: Bearer {{clientToken}}


### createApplication
POST {{baseUrl}}/applications
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "company_id": "11111111-1111-4111-8111-111111111111",
  "data": {
    "product_id": "22222222-2222-4222-8222-222222222222",
    "amount": "1200000.00",
    "term_months": 18,
    "purpose": "Закупка товарных запасов и пополнение оборотных средств интернет-магазина",
    "financials": {
      "as_of_date": "2026-10-01",
      "monthly_revenue": "1500000.00",
      "monthly_expenses": "900000.00",
      "outstanding_debt": "500000.00",
      "monthly_debt_payments": "50000.00"
    }
  }
}


### getApplication
GET {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333
Authorization: Bearer {{clientToken}}


### updateApplication
PATCH {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "expected_version": 1,
  "data": {
    "amount": "1200000.00",
    "term_months": 18,
    "purpose": "Закупка товарных запасов и пополнение оборотных средств интернет-магазина",
    "financials": {
      "as_of_date": "2026-10-01",
      "monthly_revenue": "1500000.00",
      "monthly_expenses": "900000.00",
      "outstanding_debt": "500000.00",
      "monthly_debt_payments": "50000.00"
    }
  }
}


### submitApplication
POST {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/submit
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "expected_version": 3,
  "consents": {
    "credit_history": true,
    "data_processing": true
  }
}


### listApplicationEvents
GET {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/events?limit=20&offset=0
Authorization: Bearer {{clientToken}}


### signApplication
POST {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/sign
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "expected_version": 13
}


### listDocuments
GET {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/documents?limit=20&offset=0
Authorization: Bearer {{clientToken}}


### uploadDocument
# Multipart bodies are omitted from this text collection; send a local PDF with the fields below.
# curl -X POST "http://localhost:8000/api/v1/applications/$APPLICATION_ID/documents" -H "Authorization: Bearer $ACCESS_TOKEN" -F expected_version=2 -F document_type=financial_statement -F "file=@docs/task.pdf;type=application/pdf"


### deleteDocument
DELETE {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/documents/44444444-4444-4444-8444-444444444444?expected_version=3
Authorization: Bearer {{clientToken}}


### downloadDocument
GET {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/documents/44444444-4444-4444-8444-444444444444/content
Authorization: Bearer {{clientToken}}
# Response is binary; save it from the HTTP client.


### listInformationRequests
GET {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/information-requests?limit=20&offset=0
Authorization: Bearer {{clientToken}}


### answerInformationRequest
POST {{baseUrl}}/applications/33333333-3333-4333-8333-333333333333/information-requests/55555555-5555-4555-8555-555555555555/answer
Authorization: Bearer {{clientToken}}
Content-Type: application/json

{
  "expected_version": 10,
  "answer": {
    "comment": "Уточнены финансовые показатели и действующие обязательства. Приложены финансовая отчётность и справка о задолженности.",
    "data": {
      "amount": "1200000.00",
      "term_months": 18,
      "purpose": "Закупка товарных запасов и пополнение оборотных средств интернет-магазина",
      "financials": {
        "as_of_date": "2026-10-01",
        "monthly_revenue": "1500000.00",
        "monthly_expenses": "900000.00",
        "outstanding_debt": "500000.00",
        "monthly_debt_payments": "50000.00"
      }
    },
    "document_ids": [
      "44444444-4444-4444-8444-444444444444",
      "88888888-8888-4888-8888-888888888888"
    ]
  }
}


