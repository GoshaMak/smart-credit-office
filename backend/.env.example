# Copy this file to the repository root as .env. Generate JWT_SECRET as shown
# in README.md before starting the stack. Never use a development key in prod.
JWT_SECRET=
JWT_ISSUER=credit-backend
JWT_AUDIENCE=credit-api

POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit-local-only
DATABASE_URL=postgresql+psycopg://credit:credit-local-only@postgres:5432/credit

S3_ENDPOINT=http://localstack:4566
S3_BUCKET=credit-documents
S3_REGION=us-east-1
S3_ACCESS_KEY=test
S3_SECRET_KEY=test

MOCK_URL=http://integration-mock:8001
